# Configuración de conexión a MariaDB
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=genoma
DB_CHARSET=utf8mb4

# Configuración SSL (opcional)
DB_SSL=false
DB_SSL_CA=/ruta/ca.pem
DB_SSL_CERT=/ruta/client-cert.pem
DB_SSL_KEY=/ruta/client-key.pem
DB_SSL_VERIFY_CERT=true
DB_SSL_VERIFY_IDENTITY=true

# Configuración del MCP Server
MCP_READ_ONLY=true
MCP_MAX_POOL_SIZE=10
LOG_LEVEL=info

# Orígenes permitidos para CORS (transporte HTTP)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
ALLOWED_HOSTS=localhost,127.0.0.1

# Docker Compose
PORT=3000
NETWORK_MODE=bridge
